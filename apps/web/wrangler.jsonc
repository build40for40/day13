{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dumpling",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "compatibility_date": "2026-11-04",
  "main": "worker.mjs",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/dumpling/api/*"] },
  "services": [{ "binding": "BRAIN", "service": "day13-brain" }],
  "routes": [
    // One wildcard rather than "/dumpling" and "/dumpling/*": an exact route misses "/dumpling?utm_source=…".
    { "pattern": "build40for40.com/dumpling*", "zone_name": "build40for40.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
