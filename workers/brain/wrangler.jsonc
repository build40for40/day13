{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "day13-brain",
  "account_id": "9b4d3e616e55585a0ae844f424717b43",
  "compatibility_date": "2026-11-04",
  "main": "src/index.ts",
  "vars": {
    "WORKOS_CLIENT_ID": "client_01M6E5ZDQ9XBYYE28XYN7H3XTJ",
    "LIVE_MODEL": "claude-sonnet-5-5"
  },
  // Secrets, set by the deploy workflow or with `pnpm wrangler secret put <NAME>`, and in .dev.vars locally:
  //   ANTHROPIC_API_KEY, WORKOS_API_KEY
  // No "secrets.required" list, so `wrangler dev` starts without them. A route answers 503 until its own are set. They're typed in src/env.d.ts.
  "durable_objects": {
    "bindings": [{ "name": "USER_BRAIN", "class_name": "UserBrain" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserBrain"] }],
  "routes": [
    { "pattern": "build40for40.com/day13/api", "zone_name": "build40for40.com" },
    { "pattern": "build40for40.com/day13/api/*", "zone_name": "build40for40.com" }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
